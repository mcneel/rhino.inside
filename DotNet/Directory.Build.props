<?xml version="1.0" encoding="UTF-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetFrameworks>net48;net7.0;net7.0-windows</TargetFrameworks>
    <LangVersion>10</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <RhinoInsideVersion>8.0.4</RhinoInsideVersion>
    <RhinoAPIVersion>8.0.23304.9001</RhinoAPIVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.EndsWith('windows'))">
    <UseWpf>true</UseWpf>
    <UseWinForms>true</UseWinForms>
  </PropertyGroup>
</Project>
