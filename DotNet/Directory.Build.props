<?xml version="1.0" encoding="UTF-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net48;net7.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">net7.0</TargetFrameworks>
    <LangVersion>10</LangVersion>
  </PropertyGroup>

  <!-- for Rhino>=8 in dotnet core -->
  <PropertyGroup Condition="!$(TargetFramework.StartsWith('net4'))">
    <RhinoAPIVersion>8.*</RhinoAPIVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- for Rhino>=7 in dotnet framework -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <RhinoAPIVersion>7.*</RhinoAPIVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.EndsWith('windows'))">
    <UseWpf>true</UseWpf>
    <UseWinForms>true</UseWinForms>
  </PropertyGroup>
</Project>
